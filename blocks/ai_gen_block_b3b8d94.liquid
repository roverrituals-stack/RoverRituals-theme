{% doc %}
  @prompt
    Create a CSS-based estimated delivery time display that shows delivery dates based on when an order was fulfilled, with customizable number of days that can be manually set in the CSS. Include styling for different delivery timeframes and make it easy to update the delivery days directly in the CSS code.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-delivery-display-{{ ai_gen_id }} {
    --ai-delivery-days-standard: {{ block.settings.standard_delivery_days }};
    --ai-delivery-days-express: {{ block.settings.express_delivery_days }};
    --ai-delivery-days-overnight: {{ block.settings.overnight_delivery_days }};
    
    background-color: {{ block.settings.background_color }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: 20px;
    font-family: inherit;
  }

  .ai-delivery-display__header-{{ ai_gen_id }} {
    margin: 0 0 16px 0;
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
  }

  .ai-delivery-option-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    margin-bottom: 8px;
    border-radius: {{ block.settings.option_border_radius }}px;
    transition: background-color 0.2s ease;
  }

  .ai-delivery-option-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-delivery-option-{{ ai_gen_id }}--standard {
    background-color: {{ block.settings.standard_bg_color }};
    border-left: 4px solid {{ block.settings.standard_accent_color }};
  }

  .ai-delivery-option-{{ ai_gen_id }}--express {
    background-color: {{ block.settings.express_bg_color }};
    border-left: 4px solid {{ block.settings.express_accent_color }};
  }

  .ai-delivery-option-{{ ai_gen_id }}--overnight {
    background-color: {{ block.settings.overnight_bg_color }};
    border-left: 4px solid {{ block.settings.overnight_accent_color }};
  }

  .ai-delivery-option__info-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-delivery-option__name-{{ ai_gen_id }} {
    font-weight: 600;
    font-size: {{ block.settings.option_name_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 4px 0;
  }

  .ai-delivery-option__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0;
  }

  .ai-delivery-option__date-{{ ai_gen_id }} {
    text-align: right;
    flex-shrink: 0;
    margin-left: 16px;
  }

  .ai-delivery-option__estimated-date-{{ ai_gen_id }} {
    font-weight: 600;
    font-size: {{ block.settings.date_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 4px 0;
  }

  .ai-delivery-option__day-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.day_label_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0;
  }

  .ai-delivery-note-{{ ai_gen_id }} {
    margin-top: 16px;
    padding: 12px;
    background-color: {{ block.settings.note_bg_color }};
    border-radius: {{ block.settings.option_border_radius }}px;
    font-size: {{ block.settings.note_size }}px;
    color: {{ block.settings.note_text_color }};
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-delivery-option-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .ai-delivery-option__date-{{ ai_gen_id }} {
      margin-left: 0;
      text-align: left;
    }
  }
{% endstyle %}

<delivery-calculator-{{ ai_gen_id }}
  class="ai-delivery-display-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank %}
    <h3 class="ai-delivery-display__header-{{ ai_gen_id }}">{{ block.settings.heading }}</h3>
  {% endif %}

  <div class="ai-delivery-option-{{ ai_gen_id }} ai-delivery-option-{{ ai_gen_id }}--standard" data-delivery-type="standard">
    <div class="ai-delivery-option__info-{{ ai_gen_id }}">
      <div class="ai-delivery-option__name-{{ ai_gen_id }}">{{ block.settings.standard_name }}</div>
      <div class="ai-delivery-option__description-{{ ai_gen_id }}">{{ block.settings.standard_description }}</div>
    </div>
    <div class="ai-delivery-option__date-{{ ai_gen_id }}">
      <div class="ai-delivery-option__estimated-date-{{ ai_gen_id }}" data-delivery-date></div>
      <div class="ai-delivery-option__day-label-{{ ai_gen_id }}" data-delivery-day></div>
    </div>
  </div>

  <div class="ai-delivery-option-{{ ai_gen_id }} ai-delivery-option-{{ ai_gen_id }}--express" data-delivery-type="express">
    <div class="ai-delivery-option__info-{{ ai_gen_id }}">
      <div class="ai-delivery-option__name-{{ ai_gen_id }}">{{ block.settings.express_name }}</div>
      <div class="ai-delivery-option__description-{{ ai_gen_id }}">{{ block.settings.express_description }}</div>
    </div>
    <div class="ai-delivery-option__date-{{ ai_gen_id }}">
      <div class="ai-delivery-option__estimated-date-{{ ai_gen_id }}" data-delivery-date></div>
      <div class="ai-delivery-option__day-label-{{ ai_gen_id }}" data-delivery-day></div>
    </div>
  </div>

  <div class="ai-delivery-option-{{ ai_gen_id }} ai-delivery-option-{{ ai_gen_id }}--overnight" data-delivery-type="overnight">
    <div class="ai-delivery-option__info-{{ ai_gen_id }}">
      <div class="ai-delivery-option__name-{{ ai_gen_id }}">{{ block.settings.overnight_name }}</div>
      <div class="ai-delivery-option__description-{{ ai_gen_id }}">{{ block.settings.overnight_description }}</div>
    </div>
    <div class="ai-delivery-option__date-{{ ai_gen_id }}">
      <div class="ai-delivery-option__estimated-date-{{ ai_gen_id }}" data-delivery-date></div>
      <div class="ai-delivery-option__day-label-{{ ai_gen_id }}" data-delivery-day></div>
    </div>
  </div>

  {% if block.settings.note != blank %}
    <div class="ai-delivery-note-{{ ai_gen_id }}">{{ block.settings.note }}</div>
  {% endif %}
</delivery-calculator-{{ ai_gen_id }}>

<script>
  (function() {
    class DeliveryCalculator{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.calculateDeliveryDates();
      }

      calculateDeliveryDates() {
        const deliveryOptions = this.querySelectorAll('[data-delivery-type]');
        const today = new Date();
        
        const styles = getComputedStyle(this);
        const standardDays = parseInt(styles.getPropertyValue('--ai-delivery-days-standard')) || 5;
        const expressDays = parseInt(styles.getPropertyValue('--ai-delivery-days-express')) || 2;
        const overnightDays = parseInt(styles.getPropertyValue('--ai-delivery-days-overnight')) || 1;

        const deliveryDays = {
          standard: standardDays,
          express: expressDays,
          overnight: overnightDays
        };

        deliveryOptions.forEach(option => {
          const deliveryType = option.getAttribute('data-delivery-type');
          const daysToAdd = deliveryDays[deliveryType];
          
          if (daysToAdd !== undefined) {
            const deliveryDate = new Date(today);
            deliveryDate.setDate(today.getDate() + daysToAdd);
            
            const dateElement = option.querySelector('[data-delivery-date]');
            const dayElement = option.querySelector('[data-delivery-day]');
            
            if (dateElement && dayElement) {
              const formattedDate = deliveryDate.toLocaleDateString('en-US', {
                month: 'short',
                day: 'numeric'
              });
              
              const dayName = deliveryDate.toLocaleDateString('en-US', {
                weekday: 'long'
              });
              
              dateElement.textContent = formattedDate;
              dayElement.textContent = dayName;
            }
          }
        });
      }
    }

    customElements.define('delivery-calculator-{{ ai_gen_id }}', DeliveryCalculator{{ ai_gen_id }});
  })();
</script>

