    "subhead": {
      "type": "rich-text",
      "blocks": {
        "heading_sh": {
          "type": "heading",
          "settings": {
            "heading": "The backpack built around your dog, not the bag",
            "heading_size": "h2"
          }
        },
        "text_sh": {
          "type": "text",
          "settings": {
            "text": "<p>Tired of leaving your dog behind or watching them struggle to keep up? The SecureRide is the only backpack with a buckled harness and 360° breathable mesh built to guarantee a secure fit, zero shoulder strain, and a calm dog by day one.</p>"
          }
        }
      },
      "block_order": [
        "heading_sh",
        "text_sh"
      ],
      "settings": {
        "desktop_content_position": "center",
        "content_alignment": "center",
