        "custom_liquid": "<div class=\"frm-compare-wrap\">\n  <style>\n    .frm-compare-wrap {\n      --frm-ink: #1B2B22;\n      --frm-forest: #1F3A2E;\n      --frm-forest-light: #2C5240;\n      --frm-amber: #D98E04;\n      --frm-amber-light: #F4C766;\n      --frm-cream: #FAF8F3;\n      --frm-cream-2: #F2F0E8;\n      --frm-upgraded-cell: #FFF7E8;\n      --frm-line: #E2E0D8;\n      --frm-muted: #6E7568;\n      max-width: 880px;\n      margin: 40px auto;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n      color: var(--frm-ink);\n      box-sizing: border-box;\n    }\n    .frm-compare-wrap *, .frm-compare-wrap *::before, .frm-compare-wrap *::after { box-sizing: border-box; }\n\n    .frm-compare-title {\n      text-align: center;\n      font-size: 24px;\n      font-weight: 800;\n      letter-spacing: -0.01em;\n      margin: 0 0 4px;\n      color: var(--frm-forest);\n    }\n    .frm-compare-sub {\n      text-align: center;\n      font-size: 14px;\n      color: var(--frm-muted);\n      margin: 0 0 24px;\n    }\n\n    /* ===== Table shell ===== */\n    .frm-table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }\n    .frm-table {\n      width: 100%;\n      min-width: 560px;\n      border-collapse: separate;\n      border-spacing: 12px 0;\n      table-layout: fixed;\n    }\n    .frm-table col.frm-col-label { width: 30%; }\n    .frm-table col.frm-col-data { width: 35%; }\n\n    /* ===== Header row ===== */\n    .frm-th-blank { border: none; }\n    .frm-th {\n      padding: 16px 12px;\n      text-align: center;\n      vertical-align: middle;\n      position: relative;\n    }\n    .frm-th-classic { background: var(--frm-forest); color: #fff; border-radius: 14px 14px 0 0; }\n    .frm-th-upgraded { background: var(--frm-amber); color: var(--frm-forest); border-radius: 14px 14px 0 0; }\n    .frm-head-name { display: block; font-size: 17px; font-weight: 800; }\n    .frm-head-tag {\n      display: inline-block;\n      margin-top: 6px;\n      font-size: 11px;\n      font-weight: 700;\n      text-transform: uppercase;\n      letter-spacing: 0.04em;\n      padding: 3px 9px;\n      border-radius: 100px;\n      background: rgba(255,255,255,0.18);\n    }\n    .frm-th-upgraded .frm-head-tag { background: rgba(31,58,46,0.12); }\n    /* In normal document flow (not absolutely positioned) so it can never get\n       clipped by a scrolling/overflow ancestor — see .frm-table-scroll below. */\n    .frm-best-badge {\n      display: inline-block;\n      white-space: nowrap;\n      background: var(--frm-forest);\n      color: #fff;\n      font-size: 10px;\n      font-weight: 700;\n      text-transform: uppercase;\n      letter-spacing: 0.03em;\n      padding: 4px 8px;\n      border-radius: 100px;\n      box-shadow: 0 2px 6px rgba(0,0,0,0.18);\n      margin-bottom: 8px;\n    }\n\n    /* ===== Body cells ===== */\n    .frm-label {\n      padding: 16px 4px;\n      font-size: 13.5px;\n      font-weight: 700;\n      color: var(--frm-forest);\n      vertical-align: middle;\n      border-bottom: 1px solid var(--frm-line);\n      white-space: nowrap;\n    }\n    .frm-label svg { width: 18px; height: 18px; color: var(--frm-amber); vertical-align: -4px; margin-right: 6px; }\n\n    .frm-cell {\n      background: var(--frm-cream);\n      padding: 16px 14px;\n      font-size: 14px;\n      line-height: 1.45;\n      vertical-align: middle;\n      border-bottom: 1px solid var(--frm-line);\n    }\n    .frm-cell-upgraded { background: var(--frm-upgraded-cell); border-left: 2px solid var(--frm-amber-light); }\n\n    tbody tr:nth-child(even) .frm-cell:not(.frm-cell-upgraded) { background: var(--frm-cream-2); }\n    tbody tr:last-child .frm-label,\n    tbody tr:last-child .frm-cell { border-bottom: none; }\n    tbody tr:last-child .frm-cell:nth-child(2) { border-radius: 0 0 10px 10px; }\n    tbody tr:last-child .frm-cell-upgraded { border-radius: 0 0 10px 10px; }\n\n    /* distance bars — rendered as inline SVG rects rather than nested divs\n       with inline width styles, since some themes/apps strip inline `style`\n       attributes from pasted HTML, which silently kills that approach. */\n    .frm-bars { display: flex; flex-direction: column; gap: 6px; }\n    .frm-bar-line { display: flex; align-items: center; gap: 8px; }\n    .frm-bar-svg { flex: 1; min-width: 0; width: 100%; height: 8px; display: block; }\n    .frm-bar-num { font-size: 12px; font-weight: 700; width: 62px; flex-shrink: 0; color: var(--frm-muted); }\n\n    .frm-balls { display: flex; align-items: center; gap: 6px; font-weight: 700; }\n    .frm-balls svg { width: 16px; height: 16px; color: var(--frm-amber); }\n\n    .frm-scroll-hint {\n      display: none;\n      text-align: center;\n      font-size: 12px;\n      color: var(--frm-muted);\n      margin-top: 8px;\n    }\n\n    /* ===== Mobile: keep it a real table, just let it scroll ===== */\n    @media (max-width: 640px) {\n      .frm-table { min-width: 540px; }\n      .frm-scroll-hint { display: block; }\n    }\n  </style>\n\n  <p class=\"frm-compare-title\">Classic vs Upgraded — Which FetchMate Fits Your Dog?</p>\n  <p class=\"frm-compare-sub\">Compare launch distance, drive system, and ball compatibility at a glance</p>\n\n  <div class=\"frm-table-scroll\">\n    <table class=\"frm-table\">\n      <colgroup>\n        <col class=\"frm-col-label\">\n        <col class=\"frm-col-data\">\n        <col class=\"frm-col-data\">\n      </colgroup>\n      <thead>\n        <tr>\n          <th class=\"frm-th-blank\"></th>\n          <th class=\"frm-th frm-th-classic\">\n            <span class=\"frm-head-name\">Classic</span>\n            <span class=\"frm-head-tag\">48mm Balls</span>\n          </th>\n          <th class=\"frm-th frm-th-upgraded\">\n            <span class=\"frm-best-badge\">Best for Bigger Dogs</span><br>\n            <span class=\"frm-head-name\">Upgraded</span>\n            <span class=\"frm-head-tag\">58mm Balls</span>\n          </th>\n        </tr>\n      </thead>\n      <tbody>\n        <!-- Launch Distance -->\n        <tr>\n          <td class=\"frm-label\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 12h18M3 12l4-4M3 12l4 4M21 12l-4-4M21 12l-4 4\"/></svg>\n            Launch Distance\n          </td>\n          <td class=\"frm-cell\">\n            <div class=\"frm-bars\">\n              <div class=\"frm-bar-line\"><span class=\"frm-bar-num\">3m / 10ft</span><svg class=\"frm-bar-svg\" viewBox=\"0 0 100 8\" preserveAspectRatio=\"none\"><rect x=\"0\" y=\"0\" width=\"100\" height=\"8\" rx=\"4\" fill=\"rgba(0,0,0,0.08)\"/><rect x=\"0\" y=\"0\" width=\"21\" height=\"8\" rx=\"4\" fill=\"#2C5240\"/></svg></div>\n              <div class=\"frm-bar-line\"><span class=\"frm-bar-num\">6m / 20ft</span><svg class=\"frm-bar-svg\" viewBox=\"0 0 100 8\" preserveAspectRatio=\"none\"><rect x=\"0\" y=\"0\" width=\"100\" height=\"8\" rx=\"4\" fill=\"rgba(0,0,0,0.08)\"/><rect x=\"0\" y=\"0\" width=\"43\" height=\"8\" rx=\"4\" fill=\"#2C5240\"/></svg></div>\n              <div class=\"frm-bar-line\"><span class=\"frm-bar-num\">9m / 30ft</span><svg class=\"frm-bar-svg\" viewBox=\"0 0 100 8\" preserveAspectRatio=\"none\"><rect x=\"0\" y=\"0\" width=\"100\" height=\"8\" rx=\"4\" fill=\"rgba(0,0,0,0.08)\"/><rect x=\"0\" y=\"0\" width=\"64\" height=\"8\" rx=\"4\" fill=\"#2C5240\"/></svg></div>\n            </div>\n          </td>\n          <td class=\"frm-cell frm-cell-upgraded\">\n            <div class=\"frm-bars\">\n              <div class=\"frm-bar-line\"><span class=\"frm-bar-num\">6m / 20ft</span><svg class=\"frm-bar-svg\" viewBox=\"0 0 100 8\" preserveAspectRatio=\"none\"><rect x=\"0\" y=\"0\" width=\"100\" height=\"8\" rx=\"4\" fill=\"rgba(0,0,0,0.08)\"/><rect x=\"0\" y=\"0\" width=\"43\" height=\"8\" rx=\"4\" fill=\"#D98E04\"/></svg></div>\n              <div class=\"frm-bar-line\"><span class=\"frm-bar-num\">10m / 33ft</span><svg class=\"frm-bar-svg\" viewBox=\"0 0 100 8\" preserveAspectRatio=\"none\"><rect x=\"0\" y=\"0\" width=\"100\" height=\"8\" rx=\"4\" fill=\"rgba(0,0,0,0.08)\"/><rect x=\"0\" y=\"0\" width=\"71\" height=\"8\" rx=\"4\" fill=\"#D98E04\"/></svg></div>\n              <div class=\"frm-bar-line\"><span class=\"frm-bar-num\">14m / 46ft</span><svg class=\"frm-bar-svg\" viewBox=\"0 0 100 8\" preserveAspectRatio=\"none\"><rect x=\"0\" y=\"0\" width=\"100\" height=\"8\" rx=\"4\" fill=\"rgba(0,0,0,0.08)\"/><rect x=\"0\" y=\"0\" width=\"100\" height=\"8\" rx=\"4\" fill=\"#D98E04\"/></svg></div>\n            </div>\n          </td>\n        </tr>\n\n        <!-- Drive System -->\n        <tr>\n          <td class=\"frm-label\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 11-4 0v-.09A1.65 1.65 0 009.6 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 110-4h.09A1.65 1.65 0 004.6 9.6a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 114 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9c.26.604.852 1 1.51 1H21a2 2 0 110 4h-.09a1.65 1.65 0 00-1.51 1z\"/></svg>\n            Drive System\n          </td>\n          <td class=\"frm-cell\">Conveyor belt drive</td>\n          <td class=\"frm-cell frm-cell-upgraded\"><strong>Gear side drive</strong> — built for greater reliability &amp; performance</td>\n        </tr>\n\n        <!-- Ball Size -->\n        <tr>\n          <td class=\"frm-label\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M3 12h18M12 3a14 14 0 010 18M12 3a14 14 0 000 18\"/></svg>\n            Ball Size\n          </td>\n          <td class=\"frm-cell\">48mm / 2&Prime; soft tennis balls</td>\n          <td class=\"frm-cell frm-cell-upgraded\">58mm / 2.25&Prime; ETPU balls — better suited to medium–large dogs</td>\n        </tr>\n\n        <!-- Balls Included -->\n        <tr>\n          <td class=\"frm-label\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"9\"/></svg>\n            Balls Included\n          </td>\n          <td class=\"frm-cell\"><span class=\"frm-balls\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><circle cx=\"12\" cy=\"12\" r=\"9\"/></svg>6 balls included</span></td>\n          <td class=\"frm-cell frm-cell-upgraded\"><span class=\"frm-balls\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><circle cx=\"12\" cy=\"12\" r=\"9\"/></svg>6 balls included</span></td>\n        </tr>\n      </tbody>\n    </table>\n  </div>\n  <p class=\"frm-scroll-hint\">Swipe to compare →</p>\n</div>",
        "color_scheme": "",
